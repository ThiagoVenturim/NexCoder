apiVersion: v1
kind: Secret
metadata:
  name: nexcoder-secrets
  labels:
    app.kubernetes.io/name: nexcoder
type: Opaque
stringData:
  DB_PASSWORD: "placeholder_db_password"
  NEXCODER_API_KEY: "placeholder_api_key"
  DB_URL: "postgresql+psycopg2://nexcoder:placeholder_db_password@nexcoder-db:5432/nexcoder"
